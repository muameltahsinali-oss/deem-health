# ══════════════════════════════════════════════════════════════════
# ديم هيلث (Deem Health) — إعدادات المتغيرات البيئية (Environment Variables)
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────
# 1. إعدادات الفرونت إند على Vercel (Frontend Variables)
# ──────────────────────────────────────────────────────────────────

# رابط الموقع على Vercel (بدون شرطة مائلة في النهاية)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# رابط خدمة الباكيند والتخزين على Railway (للتحويل التلقائي لرفع وعرض الصور)
# مثال: https://deem-backend-production.up.railway.app
RAILWAY_STORAGE_URL=""
NEXT_PUBLIC_STORAGE_URL=""

# رابط قاعدة بيانات PostgreSQL على Railway (اختياري عند الاتصال المباشر)
DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway"

# ──────────────────────────────────────────────────────────────────
# 2. إعدادات خدمة الباكيند والتخزين على Railway (Backend & Storage Variables)
# ──────────────────────────────────────────────────────────────────

# المنفذ الداخلي (يحدده Railway تلقائياً بـ $PORT)
PORT=3001

# مسار مجلد التخزين الدائم (Volume Mount على Railway)
UPLOAD_DIR="/app/storage/uploads"

# الدومين المسموح به لطلبات CORS (رابط موقع Vercel)
ALLOWED_ORIGIN="https://your-app.vercel.app"
