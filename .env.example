# ─────────────────────────────────────────────────────────────────────────────
#  Deem Health — environment variables
#  Copy to `.env` (used by BOTH Next.js and Prisma) and fill in the values.
#  Never commit real secrets. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Local Docker (see docker-compose.yml): postgresql://deem:deem@localhost:5432/deem_health?schema=public
DATABASE_URL="postgresql://deem:deem@localhost:5432/deem_health?schema=public"

# Public base URL of the site, no trailing slash (required in production).
# Used for canonical URLs, sitemap, Open Graph and Conversions API event_source_url.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32-byte key, base64 — encrypts secrets saved from the admin (Meta CAPI token).
# Generate with:  npm run secret:generate
# Changing it later makes previously saved tokens unreadable (re-enter them in the admin).
APP_ENCRYPTION_KEY=""

# ── Admin account (seed / `npm run admin:create`) ────────────────────────────
ADMIN_EMAIL="owner@example.com"
# At least 10 characters. Only used when seeding/creating the admin; not read at runtime.
ADMIN_PASSWORD=""
ADMIN_NAME="مدير المتجر"
# Admin session lifetime in days (default 7)
ADMIN_SESSION_DAYS="7"

# ── Meta tracking (optional — can also be set in Admin → Marketing & Tracking) ─
# Admin settings take priority over these values.
# Pixel / Dataset ID (public — safe to expose to the browser).
# NEXT_PUBLIC_META_PIXEL_ID is baked in at build time; META_PIXEL_ID (same value) is read at runtime
# and wins if both are set — use it when you change the ID without rebuilding.
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
# Conversions API access token (SECRET — server only, never exposed to the browser).
META_CAPI_ACCESS_TOKEN=""
# Test Event Code from Events Manager → Test events (only while testing; remove for production).
META_TEST_EVENT_CODE=""
# Graph API version used for Conversions API calls.
META_GRAPH_API_VERSION="v23.0"

# ── Uploads ──────────────────────────────────────────────────────────────────
# Where admin-uploaded images are stored (must be a persistent disk in production).
UPLOAD_DIR="storage/uploads"

# ── Tests (optional) ─────────────────────────────────────────────────────────
# Separate database for integration tests — it is WIPED by the test run.
TEST_DATABASE_URL="postgresql://deem:deem@localhost:5432/deem_health_test?schema=public"
